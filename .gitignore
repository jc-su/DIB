# ---------------------------------------------------------------------------
# Experiment result data — regenerated from the protocol; never committed.
# See docs/REPRODUCIBILITY.md to reproduce every number, table, and figure.
# ---------------------------------------------------------------------------
paper_runs/
outputs_*/
results_*/
aggregate_*/
smoke_outputs/
smoke_results/

# Generated task files (the generator and adapters are versioned, not the data)
tasks_*.jsonl
smoke_tasks.jsonl
# (examples/public_tasks_sample.jsonl is a tiny committed format sample)

